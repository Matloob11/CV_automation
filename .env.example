OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Incoming webhook URL from Bitrix24. Do not commit a real token.
BITRIX24_WEBHOOK_URL=https://your-company.bitrix24.com/rest/1/your-incoming-webhook-token/
BITRIX24_ENTITY_TYPE_ID=1156

# Optional n8n bridge. Current UI does not use n8n for processing.
N8N_WEBHOOK_URL=
CV_WORKFLOW_SECRET=change-this-secret

# Upload and queue settings.
MAX_CV_FILES=2000
MAX_CV_FILE_SIZE_MB=100
MAX_IMAGE_PAGES_PER_CV=3
PROCESSING_CONCURRENCY=10
CACHE_CONCURRENCY=20
MAX_IN_FLIGHT_MB=220
OPENAI_TIMEOUT_MS=180000
OPENAI_MAX_RETRIES=4
OPENAI_RETRY_BASE_MS=1000
OPENAI_RETRY_MAX_MS=20000
SNAPSHOT_EVERY_FILES=5
SNAPSHOT_INTERVAL_MS=1000
HISTORY_CACHE_MS=30000
HISTORY_PAGE_SIZE=50
MAX_HISTORY_DOWNLOAD_CANDIDATES=500
MAX_HISTORY_ARCHIVE_MB=5000
CV_STORAGE_DIR=storage
PORT=3000
